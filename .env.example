# IMPORTANT: Copy this file to .env and replace ALL placeholder values with real secrets.
# NEVER commit the .env file. It is gitignored for your protection.
#
#   cp .env.example .env
#   # Then edit .env and set every CHANGE_ME value before running docker compose up

# ─────────────────────────────────────────────────────────────────
# Security API Keys & Secrets
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────

# Key that crypto-service requires on all inbound requests (sign_hash, verify_hash, rotate)
CRYPTO_SERVICE_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Key the verification-api requires on all inbound requests (issue, status, credentials)
VERIFICATION_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Key the project-dashboard requires on all inbound /api/* requests
GATEWAY_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────
# Microservice Network Endpoints (internal Docker network names)
# ─────────────────────────────────────────────────────────────────
CRYPTO_SERVICE_URL=https://crypto-service:5001
VERIFICATION_API_URL=http://verification-api:3000
CRYPTO_SERVICE_HOST=crypto-service
VERIFICATION_API_HOST=verification-api

# ─────────────────────────────────────────────────────────────────
# HashiCorp Vault Configuration
# VAULT_DEV_MODE=true is for local dev only — uses HTTP and the root token.
# For production: set VAULT_DEV_MODE=false, use VAULT_ADDR with https://, and AppRole.
# ─────────────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=CHANGE_ME_root_token_for_dev_only
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_PATH=scatterid/mldsa

# ─────────────────────────────────────────────────────────────────
# TLS & Certificate Verification
# NOTE: Trust is established via NODE_EXTRA_CA_CERTS. Do not disable cert verification.
# ─────────────────────────────────────────────────────────────────
NODE_EXTRA_CA_CERTS=/app/certs/ca.crt

# ─────────────────────────────────────────────────────────────────
# Exposed Host Ports
# ─────────────────────────────────────────────────────────────────
PORT_VERIFICATION_API=3000
PORT_CRYPTO_SERVICE=5001
PORT_DASHBOARD=4000
PORT_VAULT=8200

# ─────────────────────────────────────────────────────────────────
# Hyperledger Fabric Network Details
# ─────────────────────────────────────────────────────────────────
FABRIC_PEER_ENDPOINT=peer0.issuer.scatterid.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.issuer.scatterid.com
FABRIC_CHANNEL_NAME=scatterid-channel
FABRIC_CHAINCODE_NAME=scatterproof
FABRIC_MSP_ID=IssuerMSP
