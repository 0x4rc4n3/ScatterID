# ScatterID Master Environment Configuration
# Copy this file to .env before starting the stack:
# cp .env.example .env

# Security API Keys & Secrets
CRYPTO_SERVICE_API_KEY=rotated-crypto-key-987654321
SHARD_NODE_API_KEY=rotated-shard-key-987654321
GATEWAY_API_KEY=rotated-gateway-key-987654321


# Microservice Network Endpoints
CRYPTO_SERVICE_URL=https://crypto-service:5001
VERIFICATION_API_URL=http://verification-api:3000
CRYPTO_SERVICE_HOST=crypto-service
VERIFICATION_API_HOST=verification-api

# HashiCorp Vault Configuration
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=rotated-vault-token-987654321

# TLS & Certificate Verification
# NOTE: trust is established via NODE_EXTRA_CA_CERTS above. Do not disable cert verification.
NODE_EXTRA_CA_CERTS=/app/certs/ca.crt

# Exposed Host Ports
PORT_VERIFICATION_API=3000
PORT_CRYPTO_SERVICE=5001
PORT_DASHBOARD=4000
PORT_VAULT=8200
PORT_SHARD_1=3001
PORT_SHARD_2=3002
PORT_SHARD_3=3003
PORT_SHARD_4=3004
PORT_SHARD_5=3005

# Hyperledger Fabric Network Details
FABRIC_PEER_ENDPOINT=peer0.issuer.scatterid.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.issuer.scatterid.com
FABRIC_CHANNEL_NAME=scatterid-channel
FABRIC_CHAINCODE_NAME=scatterproof
FABRIC_MSP_ID=IssuerMSP
